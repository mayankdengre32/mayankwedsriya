        </div>
      </div>

    </div>

  </div>

  <!-- EVENT CARDS GRID -->
  <div class="event-cards-wrap">

    <div class="event-card reveal up reveal-delay-1">
      <div class="event-card-ornament">✦ ✧ ✦</div>
