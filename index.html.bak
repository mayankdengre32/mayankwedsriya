      <div class="event-card-date">1st December</div>
      <div class="event-card-time">12:00 PM</div>
    </div>

    <div class="event-card reveal up reveal-delay-2">
      <div class="event-card-ornament">✦ ✧ ✦</div>
      <div class="event-card-name">Sangeet</div>
      <div class="event-card-date">1st December</div>
      <div class="event-card-time">07:00 PM</div>
    </div>

    <div class="event-card reveal up reveal-delay-3">
