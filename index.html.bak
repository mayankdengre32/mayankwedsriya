      <div class="event-card-name">Tilak</div>
      <div class="event-card-date">2nd December</div>
      <div class="event-card-time">12:00 PM</div>
    </div>

    <div class="event-card reveal up reveal-delay-4">
      <div class="event-card-ornament">✦ ✧ ✦</div>
      <div class="event-card-name">Barat</div>
